{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Дневник — недельное расписание v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "name",
    "timeZone",
    "days"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]).*\\S.*$"
    },
    "timeZone": {
      "const": "Europe/Moscow"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/day"
      }
    }
  },
  "$defs": {
    "time": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "lessons"
      ],
      "properties": {
        "day": {
          "enum": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ]
        },
        "lessons": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/lesson"
          }
        }
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "subject"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]).*\\S.*$"
        },
        "startTime": {
          "$ref": "#/$defs/time"
        },
        "endTime": {
          "$ref": "#/$defs/time"
        },
        "room": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]).*\\S.*$"
        },
        "teacher": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u202A-\\u202E\\u2066-\\u2069]).*\\S.*$"
        }
      },
      "allOf": [
        {
          "then": {
            "properties": {
              "endTime": {
                "type": "string"
              }
            },
            "required": [
              "endTime"
            ]
          },
          "if": {
            "properties": {
              "startTime": {
                "type": "string"
              }
            },
            "required": [
              "startTime"
            ]
          }
        },
        {
          "then": {
            "properties": {
              "startTime": {
                "type": "string"
              }
            },
            "required": [
              "startTime"
            ]
          },
          "if": {
            "properties": {
              "endTime": {
                "type": "string"
              }
            },
            "required": [
              "endTime"
            ]
          }
        }
      ]
    }
  }
}
